# Copy to .env (git ignores it) and fill in. scripts/setup_machine.sh does the copy for you.
# The run scripts export everything here; main.py also reads WANDB_API_TOKEN from .env itself.

# Weights & Biases: API key from https://wandb.ai/authorize. The key identifies your user;
# WANDB_ENTITY is the team the runs are logged under.
WANDB_API_TOKEN=
WANDB_ENTITY=IdlF26Group40
WANDB_PROJECT=ViT-perforated

# PerforatedAI license (perforatedbp checks these when it builds dendrites).
PAIEMAIL=
PAITOKEN=
